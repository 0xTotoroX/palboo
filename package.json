{
  "name": "palboo",
  "version": "1.3.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:settings": "node scripts/dev-launcher.mjs --settings",
    "dev:stop": "node scripts/dev-launcher.mjs --stop",
    "dev:materials": "node scripts/material-preview.mjs",
    "dev:site": "vite --config ui/website/vite.config.ts",
    "build:site": "tsc --noEmit && vite build --config ui/website/vite.config.ts",
    "preview:site": "vite preview --config ui/website/vite.config.ts",
    "build:web": "tsc --noEmit && vite build --config ui/settings/vite.config.ts",
    "build": "npm run build:web && cargo build --release --locked",
    "check": "npm run format:check && tsc --noEmit && node --test --test-concurrency=4 tests/*.test.mjs && npm run audit:source",
    "audit:source": "node scripts/source-audit.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "test:lifecycle": "node tests/lifecycle-test.mjs",
    "notices": "node scripts/third-party-notices.mjs",
    "install:local": "node scripts/install.mjs",
    "package": "node scripts/package.mjs",
    "test:native": "node tests/native-check.mjs",
    "format": "prettier --write \"ui/**/*.{js,ts,tsx,css}\" \"scripts/**/*.mjs\" \"tests/*.mjs\"",
    "format:check": "prettier --check \"ui/**/*.{js,ts,tsx,css}\" \"scripts/**/*.mjs\" \"tests/*.mjs\"",
    "verify": "node scripts/verify.mjs",
    "verify:web": "node scripts/verify-web.mjs",
    "test:glass": "node tests/embedded-glass.mjs",
    "test:site": "node --test tests/website.test.mjs",
    "test:workbench": "node tests/workbench.mjs",
    "install:dev": "node scripts/dev-launcher.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^25.10.10",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.7.0",
    "tokenx": "2.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "0.25.12",
    "playwright": "^1.55.0",
    "prettier": "3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2",
    "vite": "^6.3.5"
  }
}
